{
  "name": "sola-cloud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docker:build": "docker buildx bake --allow=fs.read=.. --file docker-bake.hcl --load",
    "start:call-graph": "pnpm --dir ./apps/call-graph-service start:dev",
    "test:call-graph": "pnpm --dir ./apps/call-graph-service test",
    "start:gateway": "pnpm --dir ./apps/gateway-service start:dev",
    "start:system": "pnpm --dir ./apps/system-service start:dev",
    "start:middleware": "pnpm --dir ./apps/middleware-service start:dev",
    "start:rag": "pnpm --dir ./apps/rag-service start:dev",
    "start:web": "pnpm --dir ./web/NestCloudWeb dev",
    "build:web": "pnpm --dir ./web/NestCloudWeb build",
    "build": "pnpm -r --if-present run build",
    "format": "oxfmt --write \"apps/**/*.ts\" \"web/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\"",
    "lint": "node ./scripts/run-oxlint.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "tsgo": "node ./scripts/run-tsgo.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@bull-board/api": "^9.13.2",
    "@bull-board/express": "^9.13.2",
    "@nest-cloud/sdk": "file:../NestCloud-Sdk",
    "@nestjs/common": "^12.6.0",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-jaeger": "^2.12.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "bullmq": "^6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
