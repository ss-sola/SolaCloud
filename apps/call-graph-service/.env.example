ServiceName=call-graph-service
Port=3500
GlobalPrefix=api
# 填写与 system-service 相同的会话签名密钥、Redis、前缀和 cookie 名。
SessionSecret=
SessionRedisUrl=redis://127.0.0.1:6379/2
SessionKeyPrefix=solacloud-local:session
SessionCookieName=solacloud.local.sid
# 服务主机上可信项目的绝对路径。多个项目用英文分号分隔，Koa 与 NestJS 自动识别。
CallGraphProjectDirs=E:\project\wzj-nodejs-v2
# RegistryUrl=http://127.0.0.1:3001
