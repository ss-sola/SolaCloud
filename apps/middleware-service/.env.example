# ---------- 本地启动必填 ----------
# 服务名用于匹配配置文件。RegistryUrl 是控制面地址的 JSON 字符串数组。
ServiceName=middleware-service
RegistryUrl=["http://127.0.0.1:3001"]

# ---------- 本地启动条件必填 ----------
# Token 按 RegistryUrl 顺序填写。未启用鉴权的节点用空字符串占位。
ControlPlaneToken=[""]

# ---------- 本地启动可选 ----------
# 额外拉取的配置文件名，多个用逗号分隔，例如 shared.jsonc。
ConfigNames=

# ---------- 配置中心 ----------
# 接入配置中心时在远端填写本段。本地同名配置会覆盖远端值。
# 标有「启动必填」的项需在配置中心填写，或在本地运行时提供。

# 控制台日志输出级别，例如 info。
ConsoleLogLevel=info
# 启动必填。服务连接的数据库名称。
DbDatabase=solacloud_local
# 启动必填。TypeORM 数据库驱动。使用 PostgreSQL 时填 postgres。
DbDriver=postgres
# 启动必填。数据库主机名或 IP，须能从服务运行环境访问。
DbHost=127.0.0.1
# 启动必填。数据库登录密码，与 DbUsername 配套使用。
DbPassword=
# 启动必填。数据库监听端口，PostgreSQL 通常使用 5432。
DbPort=5432
# 是否在启动时按实体定义自动同步表结构。使用 SQL 脚本管理表结构时设为 false。
DbSynchronize=false
# 启动必填。服务连接数据库使用的账号。
DbUsername=solacloud_local_app
# Redis 中附件上传会话和合并锁等键的前缀。
FileUploadRedisPrefix=solacloud-local:upload
# 服务 API 的公共路由前缀，例如 api 对应 /api。
GlobalPrefix=api
# 服务运行环境。配置为 production 时启用仅生产环境执行的自动注册。
NodeEnv=production
# 启动必填。当前实例的 HTTP 监听端口。同机运行多个实例时，可在各自的 .env 中覆盖。
Port=3300
# BullMQ 队列的 Redis 键前缀。处理同一组队列的实例需保持一致。
QueuePrefix=solacloud-local:queues
# 启动必填。BullMQ 保存任务、状态和调度信息的 Redis 连接地址。
QueueRedisUrl=redis://127.0.0.1:6379/3
# 向注册中心通告的实例主机名或 IP，需能从调用方访问。
ServiceHost=127.0.0.1
# 浏览器保存会话 ID 的 Cookie 名称。共享登录态的服务需使用相同名称。
SessionCookieName=solacloud.local.sid
# Redis 中会话键的前缀。共享登录态的服务需使用相同前缀。
SessionKeyPrefix=solacloud-local:session
# 会话存储的 Redis 连接地址。共享登录态的服务需连接同一实例和逻辑库。
SessionRedisUrl=redis://127.0.0.1:6379/2
# 启动必填。会话 Cookie 签名密钥。共享登录态的服务需使用同一密钥。
SessionSecret=
# 分片上传期间暂存附件分片的目录，需对服务进程可写。
UploadChunkTempRootDir=../../.local-data/chunks
# 生成或识别附件访问链接所用的基础 URL。
UploadPublicBaseUrl=http://127.0.0.1:3300/public/uploads
# 已上传附件在文件系统上的根目录。读写同一份附件的服务需访问同一存储。
UploadRootDir=../../.local-data/uploads

# ---------- 配置中心可选 ----------
# SDK 扫描自动注册模块的 glob，通常使用默认值。
Pattern=dist/**/*.js
# 跨服务写请求重试。接收实例均支持同事务幂等时才开启。
RemoteWriteRetryEnabled=false
# 向注册中心广播的完整服务地址。省略时使用实例地址和路由前缀。
ServiceBaseUrl=https://api.example.com/api
# 注册心跳间隔（毫秒）。
HeartbeatInterval=30000
# 注册实例列表同步间隔（毫秒）。
SyncInterval=15000
# 注册实例元数据，在配置中心使用 JSON 对象。
# JSONC 示例："ServiceMetadata": {"zone":"local"}
# 会话有效期（毫秒），共享会话的实例保持一致。
SessionTtlMs=28800000
# 会话 Cookie 的 SameSite 策略。
SessionSameSite=lax
# 仅允许 HTTPS 发送会话 Cookie。HTTPS 部署时可设为 true。
SessionSecure=false
# 单文件上传上限（字节）。
UploadMaxSizeBytes=1048576000
# 文件链接使用的公开地址。
ServicePublicBaseUrl=https://api.example.com
# 临时上传文件保留时长（毫秒）。
UploadTempTtlMs=86400000
# 普通任务队列默认并发数。
QueueDefaultConcurrency=2
# 任务默认最大尝试次数。
QueueDefaultAttempts=3
# 任务重试默认退避时间（毫秒）。
QueueDefaultBackoffMs=5000
# 临时上传清理任务的 cron 表达式。
QueueCleanupCron="15 */1 * * *"
# 是否启用 Bull Board 队列面板。
BullBoardEnabled=false
# Bull Board 队列面板挂载路径。
BullBoardRoute=/admin/queues
# 附件向量化与描述回填任务的并发数。
AttachmentVectorizeConcurrency=5
