# ---------- 本地启动必填 ----------
# 服务名用于匹配配置文件。RegistryUrl 是控制面地址的 JSON 字符串数组。
ServiceName=gateway-service
RegistryUrl=["http://127.0.0.1:3001"]

# ---------- 本地启动条件必填 ----------
# Token 按 RegistryUrl 顺序填写。未启用鉴权的节点用空字符串占位。
ControlPlaneToken=[""]

# ---------- 本地启动可选 ----------
# 额外拉取的配置文件名，多个用逗号分隔，例如 shared.jsonc。
ConfigNames=

# ---------- 配置中心 ----------
# 接入配置中心时在远端填写本段。本地同名配置会覆盖远端值。
# 标有「启动必填」的项需在配置中心填写，或在本地运行时提供。

# 静态路由模式下，网关转发调用图请求的服务地址。
GatewayCallGraphUrl=http://127.0.0.1:3500
# 静态路由模式下，网关转发中间件请求的服务地址。
GatewayMiddlewareUrl=http://127.0.0.1:3300
# 静态路由模式下，网关转发 RAG 请求的服务地址。
GatewayRagUrl=http://127.0.0.1:3400
# 静态路由模式下，网关转发系统请求的服务地址。
GatewaySystemUrl=http://127.0.0.1:3200
# 上游寻址方式：static 使用配置的服务地址，registry 从注册中心发现实例。
GatewayUpstreamMode=static
# 当前实例的 HTTP 监听端口。同机运行多个实例时，可在各自的 .env 中覆盖。
Port=3100

# ---------- 配置中心可选 ----------
# 控制台最低日志级别。
ConsoleLogLevel=info
# 运行环境。production 用于生产环境。
NodeEnv=development
# SDK 扫描自动注册模块的 glob，通常使用默认值。
Pattern=dist/**/*.js
# 跨服务写请求重试。接收实例均支持同事务幂等时才开启。
RemoteWriteRetryEnabled=false
# 网关要求路由前缀为空。
GlobalPrefix=
# 允许跨域访问的前端 origin 列表，以逗号分隔。
GatewayAllowedOrigins=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# 可信代理的 IP 列表，以逗号分隔。
GatewayTrustedProxyIps=
# 拉取注册实例的间隔（毫秒）。
GatewayRegistrySyncMs=15000
# 注册实例快照的有效期（毫秒）。
GatewayRegistrySnapshotMs=45000
# 上游注册实例的租约有效期（毫秒）。
GatewayRegistryLeaseMs=180000
# 连接上游的超时（毫秒）。
GatewayConnectTimeoutMs=3000
# 普通请求和响应的空闲超时（毫秒）。
GatewayIdleTimeoutMs=60000
# 流式响应的空闲超时（毫秒）。
GatewayStreamIdleTimeoutMs=180000
# 转发请求体的最大字节数。
GatewayMaxBodyBytes=106954752
