{
  "name": "rag-service",
  "version": "0.0.1",
  "private": true,
  "description": "RAG service with LangChain and pgvector",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write \"src/**/*.ts\" \"src/__tests__/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src",
    "test": "vitest run --config ../../scripts/vitest.backend.unit.config.ts",
    "test:watch": "vitest watch --config ../../scripts/vitest.backend.unit.config.ts",
    "test:cov": "vitest run --coverage --config ../../scripts/vitest.backend.unit.config.ts",
    "test:debug": "vitest run --inspectBrk --config ../../scripts/vitest.backend.unit.config.ts --no-file-parallelism",
    "test:e2e": "vitest run --config ../../scripts/vitest.backend.e2e.config.ts"
  },
  "dependencies": {
    "@langchain/community": "^1.1.0",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.0",
    "@langchain/tavily": "^1.2.0",
    "@nest-cloud/sdk": "file:../../../NestCloud-Sdk",
    "@nestjs/serve-static": "^5.0.5",
    "any-extractor": "^2.0.5",
    "deepagents": "^1.10.7",
    "fast-xml-parser": "^5.9.3",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "langchain": "^1.5.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^14.1.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pgvector": "^0.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
