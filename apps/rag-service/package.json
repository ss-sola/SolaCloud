{
  "name": "rag-service",
  "version": "0.0.1",
  "private": true,
  "description": "RAG service with LangChain and pgvector",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write \"src/**/*.ts\" \"src/__tests__/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src",
    "test": "vitest run --config ../../scripts/vitest.backend.unit.config.ts",
    "test:watch": "vitest watch --config ../../scripts/vitest.backend.unit.config.ts",
    "test:cov": "vitest run --coverage --config ../../scripts/vitest.backend.unit.config.ts",
    "test:debug": "vitest run --inspectBrk --config ../../scripts/vitest.backend.unit.config.ts --no-file-parallelism",
    "test:e2e": "vitest run --config ../../scripts/vitest.backend.e2e.config.ts"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.4.2",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/openai": "^1.8.4",
    "@langchain/tavily": "^1.2.1",
    "@nest-cloud/sdk": "file:../../../NestCloud-Sdk",
    "@nestjs/serve-static": "^12.1.1",
    "any-extractor": "^3.1.0",
    "deepagents": "^1.17.0",
    "fast-xml-parser": "^5.12.1",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "langchain": "^1.6.7",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5",
    "@solacloud/http-trace-log": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  }
}
