{
  // 控制台日志输出级别，例如 info。
  "ConsoleLogLevel": "info",
  // 服务连接的数据库名称。
  "DbDatabase": "solacloud_local",
  // TypeORM 数据库驱动。使用 PostgreSQL 时填 postgres。
  "DbDriver": "postgres",
  // 数据库主机名或 IP，须能从服务运行环境访问。
  "DbHost": "127.0.0.1",
  // 数据库登录密码，与 DbUsername 配套使用。
  "DbPassword": "",
  // 数据库监听端口，PostgreSQL 通常使用 5432。
  "DbPort": 5432,
  // 是否在启动时按实体定义自动同步表结构。使用 SQL 脚本管理表结构时设为 false。
  "DbSynchronize": false,
  // 服务连接数据库使用的账号。
  "DbUsername": "solacloud_local_app",
  // 服务 API 的公共路由前缀，例如 api 对应 /api。
  "GlobalPrefix": "api",
  // 服务运行环境。配置为 production 时启用仅生产环境执行的自动注册。
  "NodeEnv": "production",
  // 当前实例的 HTTP 监听端口。同机运行多个实例时，可在各自的 .env 中覆盖。
  "Port": 3200,
  // 向注册中心通告的实例主机名或 IP，需能从调用方访问。
  "ServiceHost": "127.0.0.1",
  // 浏览器保存会话 ID 的 Cookie 名称。共享登录态的服务需使用相同名称。
  "SessionCookieName": "solacloud.local.sid",
  // Redis 中会话键的前缀。共享登录态的服务需使用相同前缀。
  "SessionKeyPrefix": "solacloud-local:session",
  // 会话存储的 Redis 连接地址。共享登录态的服务需连接同一实例和逻辑库。
  "SessionRedisUrl": "redis://127.0.0.1:6379/2",
  // 会话 Cookie 签名密钥。共享登录态的服务需使用同一密钥。
  "SessionSecret": "",
  // 查询 Loki 日志时匹配的 job 标签值，需与日志采集端一致。
  "TraceLogLokiJob": "solacloud-local",
  // 用于查询集中日志的 Loki 服务地址。留空时停用集中日志查询。
  "TraceLogLokiUrl": "",
  // 可信反向代理的 IP 地址，多个地址用英文逗号分隔。
  "TrustedProxyIps": "127.0.0.1"
}
